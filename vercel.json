{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:api",
  "outputDirectory": ".",
  "crons": [
    {
      "path": "/api/sync",
      "schedule": "17 9 * * 2"
    },
    {
      "path": "/api/waivers/process",
      "schedule": "17 10 * * 3"
    }
  ],
  "functions": {
    "api/sync.js": {
      "maxDuration": 60
    },
    "api/live-matchups.js": {
      "maxDuration": 60
    },
    "api/waivers/process.js": {
      "maxDuration": 60
    }
  }
}
