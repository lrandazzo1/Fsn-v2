# FSN v2 — background sports-data sync
# Copy to .env (git-ignored) and export before running `npm run sync:data`.
# Nothing here is read by the browser app: js/config.js keeps its own
# publishable key, and the sync RPCs are granted to service_role only.

# ---------------------------------------------------------------- provider ---
# Which fetcher answers the sync calls. `fixture` replays lib/fixtures/tank01
# and needs no key — that is what `npm run test:sync-data` uses.
SPORTS_DATA_PROVIDER=tank01

# Tank01 NFL Live In-Game Real Time Statistics (RapidAPI), or any RapidAPI host
# that returns the same `{ statusCode, body }` envelope.
SPORTS_DATA_API_KEY=
SPORTS_DATA_API_HOST=tank01-nfl-live-in-game-real-time-statistics-nfl.p.rapidapi.com

# Optional: a non-RapidAPI base URL or different auth header names.
# SPORTS_DATA_BASE_URL=https://api.example.com/nfl/v2
# SPORTS_DATA_API_KEY_HEADER=x-rapidapi-key
# SPORTS_DATA_API_HOST_HEADER=x-rapidapi-host

# Optional: point an endpoint somewhere else without touching code.
# SPORTS_DATA_ENDPOINT_TEAMS=/getNFLTeams
# SPORTS_DATA_ENDPOINT_PLAYER_LIST=/getNFLPlayerList
# SPORTS_DATA_ENDPOINT_PROJECTIONS=/getNFLProjections
# SPORTS_DATA_ENDPOINT_GAMES=/getNFLGamesForWeek
# SPORTS_DATA_ENDPOINT_BOX_SCORE=/getNFLBoxScore

# ------------------------------------------------------------------ season ---
# Defaults to the season the current date falls in (Sep–Feb belongs to the
# earlier year), 'reg' and 'ppr'.
# SPORTS_DATA_SEASON=2026
# SPORTS_DATA_SEASON_TYPE=reg
# SPORTS_DATA_SCORING=ppr
# SPORTS_DATA_SCHEDULE_WEEKS=18

# ------------------------------------------------------------------- limits ---
# SPORTS_DATA_BATCH_SIZE=120        # rows per upsert RPC call
# SPORTS_DATA_TIMEOUT_MS=15000
# SPORTS_DATA_MAX_RETRIES=3         # on 429/5xx/socket errors, exponential backoff
# SPORTS_DATA_RETRY_BASE_MS=500
# SPORTS_DATA_RATE_LIMIT_MS=0       # minimum gap between provider calls
# SPORTS_DATA_MAX_GAMES_PER_WEEK=16
# SPORTS_DATA_DRY_RUN=0             # map everything, write nothing

# ---------------------------------------------------------------- database ---
# The sync writes through public.fsnv2_sync_* , which are granted to
# service_role only — a publishable key will be refused by Postgres.
SUPABASE_URL=https://opfrwtjqjciqpmajeqlr.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------------- logging ---
# SPORTS_DATA_LOG_LEVEL=info        # debug | info | warn | error | silent
# SPORTS_DATA_LOG_JSON=0            # 1 for one JSON object per line

# ------------------------------------------------------------------ testing ---
# SPORTS_DATA_TEST_LIVE=1           # let `npm run test:sync-data` write to Supabase
